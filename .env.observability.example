# Copie para .env.observability (gitignored) e preencha. Usado por scripts/create-observability-secrets.sh
# New Relic: one.newrelic.com > API Keys > INGEST - LICENSE
NEW_RELIC_LICENSE_KEY=
# PagerDuty: Service > Integrations > Events API V2 > Integration Key
PAGERDUTY_ROUTING_KEY=
# Discord: Configurações do canal > Integrações > Webhooks > Copiar URL
DISCORD_WEBHOOK_URL=
# Grafana (login admin)
GRAFANA_ADMIN_PASSWORD=
# Master key do auth-service (também protege /admin/chaos no flag-service)
MASTER_KEY=
